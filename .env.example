# Client ID público do aplicativo criado no Spotify Developer Dashboard.
NEXT_PUBLIC_SPOTIFY_CLIENT_ID=

# Opcional. Deixe vazio para usar automaticamente <domínio atual>/callback.
# NEXT_PUBLIC_SPOTIFY_REDIRECT_URI=https://visual-spotymusic-live.manomizer.chatgpt.site/callback

# Client ID do aplicativo criado no Jamendo Developer Portal.
# Necessário para consultar o catálogo e reproduzir faixas do Jamendo.
NEXT_PUBLIC_JAMENDO_CLIENT_ID=

# Hash SHA-256 da senha administrativa usada no gate de /admin e /jamendo-test.
# Armazene somente o hash; não coloque a senha em texto puro no projeto.
NEXT_PUBLIC_ADMIN_PASSWORD_SHA256=

# Google AdSense. Use apenas os identificadores públicos fornecidos pelo painel.
# Exemplo de cliente: ca-pub-1234567890123456
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
NEXT_PUBLIC_ADSENSE_LOGIN_RECTANGLE_SLOT=
NEXT_PUBLIC_ADSENSE_LOGIN_BANNER_SLOT=
