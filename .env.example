# Spotify: configure apenas o Client ID público na hospedagem.
NEXT_PUBLIC_SPOTIFY_CLIENT_ID=

# Opcional. Sem esta variável, o site usa automaticamente o domínio atual.
# NEXT_PUBLIC_SPOTIFY_REDIRECT_URI=https://visual-spotymusic-live.manomizer.chatgpt.site/callback

# Google AdSense: mantenha vazio até receber os identificadores públicos.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
NEXT_PUBLIC_ADSENSE_LOGIN_RECTANGLE_SLOT=
NEXT_PUBLIC_ADSENSE_LOGIN_BANNER_SLOT=
